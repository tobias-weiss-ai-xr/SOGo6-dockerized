{
  "__inputs": [],
  "__requires": [],
  "title": "SOGo 6 — System Overview",
  "uid": "sogo6-overview",
  "panels": [
    {
      "title": "API Requests",
      "type": "graph",
      "targets": [{"expr": "rate(sogo_api_requests_total[5m])", "legendFormat": "{{method}} {{endpoint}}"}]
    },
    {
      "title": "Active Users",
      "type": "stat",
      "targets": [{"expr": "sogo_active_users"}]
    },
    {
      "title": "IMAP Connections",
      "type": "graph",
      "targets": [{"expr": "rate(sogo_imap_connections_total[5m])", "legendFormat": "{{status}}"}]
    },
    {
      "title": "SMTP Messages",
      "type": "graph",
      "targets": [{"expr": "rate(sogo_smtp_messages_total[5m])", "legendFormat": "{{status}}"}]
    },
    {
      "title": "Redis Memory",
      "type": "gauge",
      "targets": [{"expr": "sogo_redis_memory_bytes / sogo_redis_maxmemory_bytes * 100"}],
      "unit": "percent"
    },
    {
      "title": "Database Connections",
      "type": "graph",
      "targets": [{"expr": "sogo_db_connections"}]
    },
    {
      "title": "Error Rate",
      "type": "graph",
      "targets": [{"expr": "rate(sogo_errors_total[5m])", "legendFormat": "{{level}}"}]
    }
  ],
  "tags": ["sogo", "mail", "groupware"]
}
