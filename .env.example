# =============================================================================
# SOGo 6 — Production Environment Variables
# =============================================================================
# Copy this file to .env and fill in all values before deploying.
# Generate strong passwords with: openssl rand -base64 24
# =============================================================================

# ═════════════════════════════════════════════════════════════════════════════
# REQUIRED — must be set before starting the stack
# ═════════════════════════════════════════════════════════════════════════════

# ── Authentication ──────────────────────────────────────────────────────────
LDAP_ADMIN_PASSWORD=        # OpenLDAP admin password (required for auth-ldap profile)
LDAP_CONFIG_PASSWORD=       # OpenLDAP config password

# ── Databases ───────────────────────────────────────────────────────────────
PG_PASSWORD=                # PostgreSQL password (required for db-postgres profile)
MARIADB_ROOT_PASSWORD=      # MariaDB root password (required for db-mariadb profile)
MARIADB_USER=sogo            # MariaDB application username (default: sogo)
MARIADB_PASSWORD=            # MariaDB application user password
MARIADB_DATABASE=sogo        # MariaDB database name (default: sogo)

# ── Mail Server ─────────────────────────────────────────────────────────────
STALWART_DB_PASSWORD=       # Stalwart mail server database password

# ── Inter-service Communication ─────────────────────────────────────────────
INTERCOM_SHARED_SECRET=     # Shared secret for nubusintercom HMAC signing
SCIM_BEARER_TOKEN=          # Bearer token for SCIM API access (UI provisioning)

# ── Encryption ──────────────────────────────────────────────────────────────
SOGO_AES_ENC_KEY=           # AES encryption key for sensitive DB data (32 chars)

# ═════════════════════════════════════════════════════════════════════════════
# OPTIONAL — defaults are safe for development
# ═════════════════════════════════════════════════════════════════════════════

# ── Logging ─────────────────────────────────────────────────────────────────
SOGO_LOG_LEVEL=info         # DEBUG | INFO | WARNING | ERROR | CRITICAL (default: info)
SOGO_JSON_LOG=1             # 1 = structured JSON, 0 = plain text (default: 1 in production)
SOGO_LOG_DIR=/var/log/sogo  # Log output directory

# ── Database Backend ────────────────────────────────────────────────────────
SOGO_DB_TYPE=PostgreSQL     # PostgreSQL | MySQL (default: PostgreSQL)
SOGO_DB_URI=                # Full DB URI (auto-built if empty, override for custom setups)

# ── Redis Cache ─────────────────────────────────────────────────────────────
SOGO_REDIS_URI=redis://redis:6379/0   # Redis connection string

# ── LDAP ─────────────────────────────────────────────────────────────────────
SOGO_LDAP_URI=ldap://ldap:389        # LDAP server URI
SOGO_LDAP_BASE_DN=dc=example,dc=org  # LDAP base DN
SOGO_LDAP_BIND_DN=cn=admin,dc=example,dc=org  # LDAP bind DN

# ── Ports (change if ports conflict) ────────────────────────────────────────
API_PORT=5001               # SOGo API HTTP port (host)
UI_PORT=3000                # SOGo UI HTTP port (host)
PG_PORT=5432                # PostgreSQL port (host)
REDIS_PORT=6379             # Redis port (host)
LDAP_PORT=389               # LDAP port (host)
MARIADB_PORT=3306           # MariaDB port (host)
PROMETHEUS_PORT=9090        # Prometheus port (host)
GRAFANA_PORT=3001           # Grafana port (host)
LOKI_PORT=3100              # Loki port (host)

# ── Optional Services (profiles) ────────────────────────────────────────────
MINIO_PASSWORD=             # MinIO root password (required for minio profile)
KEYCLOAK_PASSWORD=          # Keycloak admin password (required for idp-keycloak profile)
COLLABORA_PASSWORD=         # Collabora admin password (required for collabora profile)
STALWART_DB_NAME=           # Stalwart database name (default: stalwart)

# ── UI Configuration ────────────────────────────────────────────────────────
NEXT_PUBLIC_ADMIN_DOMAINS=admin.localhost  # Comma-separated admin domain list
SOGO_TEST_USER=mmustermann@example.org     # Pre-filled login email (dev only)
SOGO_PUBLIC_BASE_URL=http://localhost:3000  # Public-facing URL for redirects (SSO, WebAuthn, password reset)
SOGO_TEST_PASS=UniMarburg2026!             # Pre-filled login password (dev only)

# ── E2E Test Configuration ──────────────────────────────────────────────────
E2E_API_HOST=localhost      # API host for E2E tests
E2E_UI_HOST=localhost       # UI host for E2E tests

# ═════════════════════════════════════════════════════════════════════════════
# SAML2 SSO — Federation-grade SAML2 Service Provider
# ═════════════════════════════════════════════════════════════════════════════
# SOGo acts as a SAML2 SP trusting an external IdP (e.g., Shibboleth, Keycloak,
# DFN-AAI federation). See docs/SAML2_FEDERATION_SETUP.md for full setup guide.
#
# ── SP keypair ─────────────────────────────────────────────────────────────
# Generate with: openssl req -x509 -newkey rsa:2048 -keyout sp-key.pem \
#   -out sp-cert.pem -days 3650 -nodes -subj "/CN=sogo-sp"
# Mount the files at /etc/sogo/saml/ (see docker-compose.yaml volume).
SOGO_SAML2_SP_CERT_FILE=/etc/sogo/saml/sp-cert.pem  # SP X.509 cert (PEM)
SOGO_SAML2_SP_KEY_FILE=/etc/sogo/saml/sp-key.pem   # SP private key (PEM)
SOGO_SAML2_METADATA_CACHE_TTL=21600                  # IdP/federation metadata Redis cache TTL (seconds, default 6h)
SOGO_SAML2_FEDERATION_METADATA_CERT=                # Federation metadata signing cert (PEM) for verifying aggregate signatures
SOGO_SAML2_CLOCK_SKEW=60                             # Clock skew tolerance for SAML conditions (seconds)
#
# ── Per-domain SAML2 settings (configured via admin API, not env) ───────────
# SOGO_D_SAML2_URL                    IdP SSO URL (simple mode, single IdP)
# SOGO_D_SAML2_IDP_METADATA_URL       IdP metadata URL (auto-configure from metadata)
# SOGO_D_SAML2_IDP_ENTITY_ID          Expected IdP entity ID (for issuer validation)
# SOGO_D_SAML2_FEDERATION_METADATA_URL  Federation aggregate metadata URL (multi-IdP)
# SOGO_D_SAML2_DISCOVERY_SERVICE_URL  External WAYF/DS URL (optional)
# SOGO_D_SAML2_ATTRIBUTE_MAP          JSON: SAML attr → SOGo field mapping (e.g., {"email":"urn:oid:0.9.2342.19200300.100.1.3"})
# SOGO_D_SAML2_WANT_ENCRYPTED_ASSERTIONS  Require encrypted assertions (bool, default false)
# SOGO_D_SAML2_AUTHN_REQUESTS_SIGNED  Sign AuthnRequests (bool, default true if keypair configured)
# SOGO_D_SAML2_SP_ENTITY_ID           SP entity ID override (default: derived from public URL)
# SOGO_D_SAML2_PROVIDER_ID            Reference to a Saml2Provider record (optional)
