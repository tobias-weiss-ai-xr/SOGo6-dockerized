# SOGo6 E2E Test Credentials — EXAMPLE. Copy to `.env` and fill in real values.
# The `.env` file is gitignored; never commit real credentials.
# Environment variables override the file (CI-friendly).
# See tests/e2e/.env for actual values on the developer machine.

# Remote demo user credentials
REMOTE_USER_EMAIL=your-testuser@example.org
REMOTE_USER_PASSWORD=CHANGE-ME

# Remote demo admin credentials
REMOTE_ADMIN_USERNAME=admin
REMOTE_ADMIN_PASSWORD=CHANGE-ME
