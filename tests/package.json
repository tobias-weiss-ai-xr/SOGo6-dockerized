{
  "name": "sogo6-e2e-tests",
  "version": "1.0.0",
  "private": true,
  "description": "Test suite for SOGo 6 + Stalwart + OpenLDAP evaluation environment",
  "scripts": {
    "test": "bash run-all-tests.sh",
    "test:api": "bash api-test.sh",
    "test:api-write": "bash api-write-test.sh",
    "test:smtp": "bash smtp-test.sh",
    "test:ldap": "bash ldap-test.sh",
    "test:docker": "bash docker-test.sh",
    "test:postgres": "bash postgres-test.sh",
    "test:nginx": "bash nginx-test.sh",
    "test:redis": "bash redis-test.sh",
    "test:concurrent": "bash concurrent-test.sh",
    "test:jmap": "bash jmap-email-test.sh",
    "test:integration": "bash integration-test.sh",
    "test:security": "bash security-test.sh",
    "test:scripts": "bash script-test.sh",
    "test:e2e": "node sogo6-e2e-test.js",
    "test:python": "SOGO_INTEGRATION_TESTS=1 python3 -m pytest integration/ -v",
    "test:headed": "node sogo6-e2e-test.js"
  },
  "dependencies": {
    "playwright": "^1.52.0"
  }
