# Development Environment Variables
# Copy to .env.development.local and customize

# Flask/Python Development
FLASK_ENV=development
FLASK_DEBUG=1
PYTHONUNBUFFERED=1
PYTHONFAULTHANDLER=1
PYTHONDEVMODE=1

# Logging
LOG_LEVEL=debug
LOG_FORMAT=%(asctime)s %(levelname)s %(name)s: %(message)s

# Node.js Development
NODE_ENV=development
DEBUG=true

# Database (development overrides)
POSTGRES_LOG_STATEMENT=all
POSTGRES_LOG_DURATION=on

# Redis (development overrides)
REDIS_LOGLEVEL=debug

# LDAP (development overrides)
SLAPD_LOG_LEVEL=32768

# Stalwart (development overrides)
RUST_LOG=debug

# Feature Flags
ENABLE_HOT_RELOAD=true
ENABLE_SOURCE_MAPS=true
ENABLE_CORS=true
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# Test Configuration
SOGO_INTEGRATION_TESTS=1
CI=false

# Debug Tools
ENABLE_PPROF=true
ENABLE_DEBUGGER=true
