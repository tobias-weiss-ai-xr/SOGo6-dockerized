# Development Dockerfile for SOGo 6 Server
# Single stage for development (source will be mounted by compose)

FROM python:3.14-slim AS development

WORKDIR /app

# Install system dependencies including LDAP and PostgreSQL
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    gcc \
    libpq-dev \
    libldap2-dev \
    libsasl2-dev \
    git \
    && rm -rf /var/lib/apt/lists/*

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    FLASK_ENV=development \
    FLASK_DEBUG=1 \
    PIP_NO_CACHE_DIR=off

# Install Poetry
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir poetry

# Copy dependency files first for better caching
COPY pyproject.toml poetry.lock* ./

# Install project dependencies via Poetry
RUN poetry config virtualenvs.create false && \
    poetry install --no-cache --no-ansi --no-interaction --no-root || \
    echo "Poetry install failed - dependencies may need manual setup"

# Install dev/debug tools
RUN pip install --no-cache-dir debugpy watchdog flask-debugtoolbar prometheus-client flask-compress authlib pyotp qrcode[pil] || true

# Copy source code (will be mounted by compose in dev)
COPY . ./

# Expose app port and debug port
EXPOSE 5000 5678

# Run with debug and auto-reload using app/run.py
CMD ["python", "-m", "debugpy", "--listen", "0.0.0.0:5678", \
     "app/run.py", "--host=0.0.0.0", "--port=5000", "--debug"]
